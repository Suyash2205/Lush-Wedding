# --- Database (Vercel Postgres / Neon) ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Clerk auth ---
# Get these from https://dashboard.clerk.com -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Resend (email) ---
# Get from https://resend.com -> API keys. Optional in dev: leave blank to disable digest.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Lush Wedding Hall <leads@your-verified-domain.com>"
OWNER_NOTIFICATION_EMAIL=owner@your-domain.com

# --- Meta / Instagram webhook ---
# Set after creating your Meta App at developers.facebook.com.
# META_VERIFY_TOKEN: any random string you choose. Paste the same string into
#   the Meta App webhook config UI ("Verify Token") and into this env var.
# META_APP_SECRET: shown on the Meta App's Basic Settings page ("App Secret").
# Profile lookup (@username): Meta has two setups — use the token from YOUR flow.
#
# META_INSTAGRAM_USER_ACCESS_TOKEN (recommended for "Instagram API" product):
#   Token from Developers → Instagram product → Welcome → Step 2 "Generate access tokens".
#   This is an Instagram USER access token; we call graph.instagram.com first.
#
# META_PAGE_ACCESS_TOKEN / INSTAGRAM_PAGE_ACCESS_TOKEN:
#   Facebook Page long-lived token for graph.facebook.com; we ALSO try graph.instagram.com
#   with this value (so your Step-2 IG token pasted here alone often works).
#
# Optional overrides if lookups fail:
# META_INSTAGRAM_GRAPH_API_VERSION=v21.0   # or v25.0 for graph.instagram.com
# META_GRAPH_API_VERSION=v21.0             # graph.facebook.com
#
# INSTAGRAM_PAGE_ID: IG Business ID (shown on Instagram API Setup / webhooks UI).
META_VERIFY_TOKEN=change-me-to-a-random-string
META_APP_SECRET=
META_INSTAGRAM_USER_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=

# --- App ---
# Public URL of this deployment (used to build webhook URLs, email links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: secret used to authenticate Vercel Cron requests.
# Vercel automatically sets the Authorization header to "Bearer ${CRON_SECRET}"
# for requests originating from the Vercel Cron scheduler.
CRON_SECRET=change-me
